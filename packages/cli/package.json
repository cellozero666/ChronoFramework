{
  "name": "@chrono/cli",
  "version": "0.1.0",
  "description": "CHRONO Framework — minimal usable CLI (interface to the Core, no policy)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "chrono": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
