{
  "name": "@chrono/cli",
  "version": "0.1.0",
  "description": "CHRONO Framework — minimal usable CLI (interface to the Core, no policy)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "chrono": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@chrono/core": "^0.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@chrono/persistence": "^0.1.0",
    "typescript": "^5.6.0"
  }
}