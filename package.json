{
  "name": "chrono-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "CHRONO Framework — Spec-Driven Development orchestration for AI-assisted software engineering",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/cli",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:host": "CHRONO_HOST_TESTS=1 vitest run host.test",
    "test:clean": "node scripts/verify-test-clean.mjs",
    "test:watch": "vitest",
    "clean": "rimraf packages/*/dist packages/*/tsconfig.tsbuildinfo tsconfig.tsbuildinfo",
    "test:blackbox": "CHRONO_BLACKBOX=1 vitest run packages/cli/src/entry-blackbox.test.ts packages/cli/src/opencode-plugin-blackbox.test.ts packages/cli/src/planning-blackbox.test.ts packages/cli/src/lifecycle-blackbox.test.ts",
    "test:network": "CHRONO_NETWORK=1 vitest run packages/cli/src/skill-network.test.ts",
    "test:workflow": "WORKFLOW_STABILIZATION=1 vitest run packages/cli/src/workflow-stabilization.test.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^22.0.0",
    "eslint": "^9.10.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0",
    "zod": "^4.1.8"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "packageManager": "npm@11.18.0",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.21.5": true
  }
}
