{
  "name": "chrono-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "CHRONO Framework — Spec-Driven Development orchestration for AI-assisted software engineering",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.10.0",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "better-sqlite3": "^9.6.0",
    "commander": "^12.1.0",
    "jsonschema": "^1.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
